<?xml version="1.0"?>
<!-- Solid-body inertia macros. Formulas: uniform box, solid cylinder about
     its own z axis, solid sphere. The inertial origin takes the same rpy as
     the shape so the tensor is expressed in the shape's frame. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="box_inertial" params="m x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m * (y*y + z*z) / 12}" ixy="0" ixz="0"
               iyy="${m * (x*x + z*z) / 12}" iyz="0"
               izz="${m * (x*x + y*y) / 12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="m r h *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m * (3*r*r + h*h) / 12}" ixy="0" ixz="0"
               iyy="${m * (3*r*r + h*h) / 12}" iyz="0"
               izz="${m * r*r / 2}"/>
    </inertial>
  </xacro:macro>

</robot>
