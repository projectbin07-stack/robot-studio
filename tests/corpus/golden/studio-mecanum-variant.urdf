<?xml version="1.0" ?>
<!-- studio_mecanum: an illustrative four-wheel mecanum base with a 2D LiDAR,
     an IMU and a depth camera, written for Robot Studio's examples. Not
     modelled on any commercial robot; dimensions and masses are plausible
     round numbers, not measurements.

     Arguments (xacro name:=value):
       use_lidar   true | false   mount the LiDAR on the top plate
       use_camera  true | false   mount the depth camera on the front
       wheel_radius               outer radius of the mecanum wheels in metres -->
<robot name="studio_mecanum">
  <material name="chassis_grey">
    <color rgba="0.32 0.35 0.40 1"/>
  </material>
  <material name="plate_silver">
    <color rgba="0.72 0.74 0.76 1"/>
  </material>
  <material name="hub_orange">
    <color rgba="0.92 0.42 0.12 1"/>
  </material>
  <material name="roller_black">
    <color rgba="0.08 0.08 0.09 1"/>
  </material>
  <material name="sensor_dark">
    <color rgba="0.15 0.16 0.18 1"/>
  </material>
  <material name="board_green">
    <color rgba="0.10 0.45 0.25 1"/>
  </material>
  <!-- REP 105: base_footprint on the ground, base_link at the wheel axles. -->
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05"/>
  </joint>
  <link name="base_link">
    <visual name="chassis">
      <origin xyz="0 0 0.009999999999999997"/>
      <geometry>
        <box size="0.3 0.2 0.06"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
    <visual name="top_plate">
      <origin xyz="0 0 0.041999999999999996"/>
