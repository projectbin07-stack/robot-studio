        <box size="0.3 0.2 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.009999999999999997"/>
      <mass value="2.2"/>
      <inertia ixx="0.007993333333333335" ixy="0" ixz="0" iyy="0.01716" iyz="0" izz="0.023833333333333335"/>
    </inertial>
  </link>
  <link name="front_left_wheel_link">
    <visual name="hub">
      <origin rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.034"/>
