<?xml version="1.0"?>
<!-- Generated by Robot Studio 1.0.0 from the 'mecanum' template (Four-wheel mecanum base).
     Parameters are xacro properties below; sensors are switched with arguments, e.g.
       xacro mecanum_bot.urdf.xacro use_lidar:=false
     Software-generated: check masses, dimensions and limits against the real robot. -->
<robot name="mecanum_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="use_lidar" default="true"/>
  <xacro:arg name="use_imu" default="true"/>
  <xacro:arg name="use_camera" default="false"/>
  <xacro:arg name="use_depth_camera" default="true"/>

  <xacro:property name="base_length" value="0.3"/>
  <xacro:property name="base_width" value="0.2"/>
  <xacro:property name="base_height" value="0.06"/>
  <xacro:property name="chassis_z" value="0.02"/>
  <xacro:property name="base_mass" value="3"/>
  <xacro:property name="wheel_radius" value="0.04"/>
  <xacro:property name="wheel_width" value="0.035"/>
  <xacro:property name="wheel_mass" value="0.15"/>
  <xacro:property name="wheelbase" value="0.2"/>
  <xacro:property name="track" value="0.25"/>
  <xacro:property name="wheel_max_speed" value="20"/>
  <xacro:property name="wheel_effort" value="2"/>
  <xacro:property name="roller_count" value="8"/>
  <xacro:property name="lidar_xyz" value="0.06 0 0.07"/>
  <xacro:property name="lidar_rpy" value="0 0 0"/>
  <xacro:property name="imu_xyz" value="0 0 0.02"/>
  <xacro:property name="imu_rpy" value="0 0 0"/>
  <xacro:property name="camera_xyz" value="0.1625 0 0.065"/>
  <xacro:property name="camera_rpy" value="0 0 0"/>
  <xacro:property name="depth_camera_xyz" value="0.165 0 0.03"/>
  <xacro:property name="depth_camera_rpy" value="0 0 0"/>

  <!-- Solid-body inertias (urdf-inspector's formulas); the inertial frame is not rotated. -->
  <xacro:macro name="box_inertial" params="m x y z xyz">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>
  <!-- Cylinder along z. -->
  <xacro:macro name="cylinder_inertial" params="m r h xyz">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>
  <!-- Cylinder along y (a wheel: its geometry is rotated by roll pi/2, so is its inertia). -->
  <xacro:macro name="wheel_inertial" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyy="${m*r*r/2}" iyz="0" izz="${m*(3*r*r+h*h)/12}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="sphere_inertial" params="m r xyz">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${2/5*m*r*r}" ixy="0" ixz="0" iyy="${2/5*m*r*r}" iyz="0" izz="${2/5*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <material name="chassis"><color rgba="0.2 0.36 0.62 1"/></material>
  <material name="wheel"><color rgba="0.15 0.15 0.17 1"/></material>
  <material name="hub"><color rgba="0.92 0.42 0.12 1"/></material>
  <material name="caster"><color rgba="0.6 0.6 0.62 1"/></material>
  <material name="sensor"><color rgba="0.08 0.08 0.09 1"/></material>

  <link name="base_footprint"/>
  <link name="base_link">
    <xacro:box_inertial m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}" xyz="0 0 ${chassis_z}"/>
    <visual>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="chassis"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <xacro:property name="roller_radius" value="${wheel_radius/5}"/>

  <!-- Rollers i .. roller_count-1 of one wheel (visual only); hand is +1 or -1. -->
  <xacro:macro name="rollers" params="i hand">
    <xacro:property name="theta" value="${2*pi*i/roller_count}"/>
    <visual name="roller_${i}">
      <origin xyz="${(wheel_radius-roller_radius)*cos(theta)} 0 ${(wheel_radius-roller_radius)*sin(theta)}" rpy="${hand*pi/4} ${-theta} 0"/>
      <geometry><cylinder radius="${roller_radius}" length="${2*pi*wheel_radius/roller_count*1.1}"/></geometry>
      <material name="wheel"/>
    </visual>
    <xacro:if value="${i + 1 &lt; roller_count}">
      <xacro:rollers i="${i + 1}" hand="${hand}"/>
    </xacro:if>
  </xacro:macro>

  <!-- One mecanum wheel on a continuous joint about +y (positive speed drives forward). -->
  <xacro:macro name="mecanum_wheel" params="name x y hand">
    <link name="${name}_wheel">
      <xacro:wheel_inertial m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      <visual name="hub">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius-2*roller_radius}" length="${wheel_width}"/></geometry>
        <material name="hub"/>
      </visual>
      <xacro:if value="${roller_count > 0}">
        <xacro:rollers i="0" hand="${hand}"/>
      </xacro:if>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="${wheel_effort}" velocity="${wheel_max_speed}"/>
    </joint>
  </xacro:macro>

  <!-- Wheels in mecanum-kinematics order: FL, FR, RL, RR. -->
  <xacro:mecanum_wheel name="front_left" x="${wheelbase/2}" y="${track/2}" hand="1"/>
  <xacro:mecanum_wheel name="front_right" x="${wheelbase/2}" y="${-track/2}" hand="-1"/>
  <xacro:mecanum_wheel name="rear_left" x="${-wheelbase/2}" y="${track/2}" hand="-1"/>
  <xacro:mecanum_wheel name="rear_right" x="${-wheelbase/2}" y="${-track/2}" hand="1"/>

  <!-- 2D LiDAR (Robot Studio sensor mount: lidar2d) -->
  <xacro:if value="$(arg use_lidar)">
    <link name="lidar_link">
      <xacro:cylinder_inertial m="0.17" r="0.035" h="0.04" xyz="0 0 0"/>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.035" length="0.04"/></geometry>
        <material name="sensor"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      </collision>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_link"/>
      <origin xyz="${lidar_xyz}" rpy="${lidar_rpy}"/>
    </joint>
  </xacro:if>

  <!-- IMU (Robot Studio sensor mount: imu) -->
  <xacro:if value="$(arg use_imu)">
    <link name="imu_link">
      <xacro:box_inertial m="0.01" x="0.02" y="0.02" z="0.005" xyz="0 0 0"/>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.02 0.02 0.005"/></geometry>
        <material name="sensor"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.02 0.02 0.005"/></geometry>
      </collision>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="${imu_xyz}" rpy="${imu_rpy}"/>
    </joint>
  </xacro:if>

  <!-- Camera (Robot Studio sensor mount: camera) -->
  <xacro:if value="$(arg use_camera)">
    <link name="camera_link">
      <xacro:box_inertial m="0.06" x="0.025" y="0.09" z="0.025" xyz="0 0 0"/>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.025 0.09 0.025"/></geometry>
        <material name="sensor"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.025 0.09 0.025"/></geometry>
      </collision>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_link"/>
      <origin xyz="${camera_xyz}" rpy="${camera_rpy}"/>
    </joint>
    <link name="camera_optical_frame"/>
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
  </xacro:if>

  <!-- Depth camera (Robot Studio sensor mount: depth_camera) -->
  <xacro:if value="$(arg use_depth_camera)">
    <link name="depth_camera_link">
      <xacro:box_inertial m="0.1" x="0.03" y="0.12" z="0.03" xyz="0 0 0"/>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.03 0.12 0.03"/></geometry>
        <material name="sensor"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.03 0.12 0.03"/></geometry>
      </collision>
    </link>
    <joint name="depth_camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="depth_camera_link"/>
      <origin xyz="${depth_camera_xyz}" rpy="${depth_camera_rpy}"/>
    </joint>
    <link name="depth_camera_optical_frame"/>
    <joint name="depth_camera_optical_joint" type="fixed">
      <parent link="depth_camera_link"/>
      <child link="depth_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
  </xacro:if>
</robot>
