<?xml version="1.0"?>
<!-- Generated by Robot Studio 0.2.0 from the 'arm' template (Serial arm (N revolute joints)).
     Parameters are xacro properties below; sensors are switched with arguments, e.g.
       xacro arm_6dof.urdf.xacro use_lidar:=false
     Software-generated: check masses, dimensions and limits against the real robot. -->
<robot name="arm_6dof" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="use_lidar" default="false"/>
  <xacro:arg name="use_imu" default="false"/>
  <xacro:arg name="use_camera" default="false"/>
  <xacro:arg name="use_depth_camera" default="false"/>

  <xacro:property name="dof" value="6"/>
  <xacro:property name="base_radius" value="0.06"/>
  <xacro:property name="base_height" value="0.05"/>
  <xacro:property name="base_mass" value="1"/>
  <xacro:property name="link_length" value="0.15"/>
  <xacro:property name="link_radius" value="0.03"/>
  <xacro:property name="link_mass" value="0.5"/>
  <xacro:property name="joint_limit" value="2.9"/>
  <xacro:property name="joint_effort" value="20"/>
  <xacro:property name="joint_velocity" value="2"/>
  <xacro:property name="lidar_xyz" value="0.1 0 0.02"/>
  <xacro:property name="lidar_rpy" value="0 0 0"/>
  <xacro:property name="imu_xyz" value="0 0 0.025"/>
  <xacro:property name="imu_rpy" value="0 0 0"/>
  <xacro:property name="camera_xyz" value="0.0125 0 0.0125"/>
  <xacro:property name="camera_rpy" value="0 -1.5707963267948966 0"/>
  <xacro:property name="depth_camera_xyz" value="0.015 0 0.015"/>
  <xacro:property name="depth_camera_rpy" value="0 -1.5707963267948966 0"/>

  <!-- Solid-body inertias (urdf-inspector's formulas); the inertial frame is not rotated. -->
  <xacro:macro name="box_inertial" params="m x y z xyz">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>
  <!-- Cylinder along z. -->
  <xacro:macro name="cylinder_inertial" params="m r h xyz">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>
  <!-- Cylinder along y (a wheel: its geometry is rotated by roll pi/2, so is its inertia). -->
  <xacro:macro name="wheel_inertial" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyy="${m*r*r/2}" iyz="0" izz="${m*(3*r*r+h*h)/12}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="sphere_inertial" params="m r xyz">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${2/5*m*r*r}" ixy="0" ixz="0" iyy="${2/5*m*r*r}" iyz="0" izz="${2/5*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <material name="arm"><color rgba="0.86 0.87 0.89 1"/></material>
  <material name="joint"><color rgba="0.92 0.42 0.12 1"/></material>
  <material name="sensor"><color rgba="0.08 0.08 0.09 1"/></material>

  <!-- A massless root fixed to the world (KDL ignores the inertia of a root link). -->
  <link name="world"/>
  <link name="base_link">
    <xacro:cylinder_inertial m="${base_mass}" r="${base_radius}" h="${base_height}" xyz="0 0 ${base_height/2}"/>
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
      <material name="joint"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
    </collision>
  </link>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Segment k and its joint, then the next segment until dof. -->
  <xacro:property name="joint_axes" value="${['0 0 1', '0 1 0', '0 1 0', '0 0 1', '0 1 0', '0 0 1']}"/>
  <xacro:macro name="segment" params="k">
    <link name="link_${k}">
      <xacro:cylinder_inertial m="${link_mass}" r="${link_radius}" h="${link_length}" xyz="0 0 ${link_length/2}"/>
      <visual>
        <origin xyz="0 0 ${link_length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${link_radius}" length="${link_length}"/></geometry>
        <material name="arm"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${link_length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${link_radius}" length="${link_length}"/></geometry>
      </collision>
    </link>
    <joint name="joint_${k}" type="revolute">
      <parent link="${'base_link' if k == 1 else 'link_' + str(k - 1)}"/>
      <child link="link_${k}"/>
      <origin xyz="0 0 ${base_height if k == 1 else link_length}" rpy="0 0 0"/>
      <axis xyz="${joint_axes[(k - 1) % 6]}"/>
      <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${joint_effort}" velocity="${joint_velocity}"/>
    </joint>
    <xacro:if value="${k &lt; dof}">
      <xacro:segment k="${k + 1}"/>
    </xacro:if>
  </xacro:macro>
  <xacro:segment k="1"/>

  <link name="tool0"/>
  <joint name="tool0_joint" type="fixed">
    <parent link="link_${dof}"/>
    <child link="tool0"/>
    <origin xyz="0 0 ${link_length}" rpy="0 0 0"/>
  </joint>

  <!-- 2D LiDAR (Robot Studio sensor mount: lidar2d) -->
  <xacro:if value="$(arg use_lidar)">
    <link name="lidar_link">
      <xacro:cylinder_inertial m="0.17" r="0.035" h="0.04" xyz="0 0 0"/>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.035" length="0.04"/></geometry>
        <material name="sensor"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      </collision>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_link"/>
      <origin xyz="${lidar_xyz}" rpy="${lidar_rpy}"/>
    </joint>
  </xacro:if>

  <!-- IMU (Robot Studio sensor mount: imu) -->
  <xacro:if value="$(arg use_imu)">
    <link name="imu_link">
      <xacro:box_inertial m="0.01" x="0.02" y="0.02" z="0.005" xyz="0 0 0"/>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.02 0.02 0.005"/></geometry>
        <material name="sensor"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.02 0.02 0.005"/></geometry>
      </collision>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="${imu_xyz}" rpy="${imu_rpy}"/>
    </joint>
  </xacro:if>

  <!-- Camera (Robot Studio sensor mount: camera) -->
  <xacro:if value="$(arg use_camera)">
    <link name="camera_link">
      <xacro:box_inertial m="0.06" x="0.025" y="0.09" z="0.025" xyz="0 0 0"/>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.025 0.09 0.025"/></geometry>
        <material name="sensor"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.025 0.09 0.025"/></geometry>
      </collision>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent link="tool0"/>
      <child link="camera_link"/>
      <origin xyz="${camera_xyz}" rpy="${camera_rpy}"/>
    </joint>
    <link name="camera_optical_frame"/>
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
  </xacro:if>

  <!-- Depth camera (Robot Studio sensor mount: depth_camera) -->
  <xacro:if value="$(arg use_depth_camera)">
    <link name="depth_camera_link">
      <xacro:box_inertial m="0.1" x="0.03" y="0.12" z="0.03" xyz="0 0 0"/>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.03 0.12 0.03"/></geometry>
        <material name="sensor"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.03 0.12 0.03"/></geometry>
      </collision>
    </link>
    <joint name="depth_camera_joint" type="fixed">
      <parent link="tool0"/>
      <child link="depth_camera_link"/>
      <origin xyz="${depth_camera_xyz}" rpy="${depth_camera_rpy}"/>
    </joint>
    <link name="depth_camera_optical_frame"/>
    <joint name="depth_camera_optical_joint" type="fixed">
      <parent link="depth_camera_link"/>
      <child link="depth_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
  </xacro:if>
</robot>
