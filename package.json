{
  "name": "robot-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Open, build and simulate robot models in the browser: xacro, URDF checks, 3D view, builder, simulated sensors and SLAM.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/core/**\" --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=80 \"tests/*.test.js\"",
    "typecheck": "tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve": "node scripts/serve.js",
    "vendor": "node scripts/vendor.mjs",
    "vendor:verify": "node scripts/vendor.mjs --verify",
    "check": "npm run format:check && npm run typecheck && npm run coverage"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "prettier": "3.10.1",
    "three": "0.187.0",
    "typescript": "7.0.2"
  },
  "bin": {
    "robot-studio": "bin/robot-studio.js"
  }
}
