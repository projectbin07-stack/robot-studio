      <mass value="2.2"/>
      <inertia ixx="0.007993333333333335" ixy="0" ixz="0" iyy="0.01716" iyz="0" izz="0.023833333333333335"/>
    </inertial>
  </link>
  <link name="front_left_wheel_link">
